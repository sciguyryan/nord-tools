{
  "schema_version": 1,
  "rules": [
    {
      "id": "host-lifecycle",
      "when_changed": ["nord_tools_internal/nordvpn_host_*.py", "nordvpn_manage.py"],
      "invalidate": ["scenario:d1", "scenario:d2", "scenario:d3", "pytest:*host*", "pytest:*wireguard*"],
      "reason": "Host protection, activation and recovery share runtime behaviour"
    },
    {
      "id": "acceptance-manager",
      "when_changed": ["scripts/acceptance-manager.py"],
      "invalidate": ["scenario:*", "pytest:scripts/test_acceptance_manager.py"],
      "reason": "Acceptance orchestration changes affect scenario execution and manager behaviour"
    },
    {
      "id": "shared-test-configuration",
      "when_changed": ["pytest.ini", "pyproject.toml", "setup.cfg", "tox.ini", "tests/conftest.py", "scripts/conftest.py"],
      "invalidate": ["pytest:*"],
      "reason": "Shared collection and fixture configuration"
    }
  ]
}
